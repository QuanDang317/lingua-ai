# ==============================================================================
# LINGUAAI - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# --- App General ---
APP_NAME="LinguaAI"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/api/v1"

# --- Database & Cache ---
# Production / Docker PostgreSQL 16 (Default when running via docker-compose):
DATABASE_URL="postgresql+asyncpg://lingua:lingua_secret@localhost:5432/linguaai"
# Local Fallback SQLite Async (Used automatically if PostgreSQL is unreachable in dev):
LOCAL_SQLITE_URL="sqlite+aiosqlite:///./linguaai_dev.db"
AUTO_FALLBACK_SQLITE=true

REDIS_URL="redis://localhost:6379/0"

# --- Authentication & Security ---
JWT_SECRET_KEY="linguaai-super-secret-jwt-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Provider-Agnostic AI Layer Selector ---
# Options for LLM_PROVIDER: "gemini" | "openai" | "adaptive_local"
LLM_PROVIDER="gemini"
# Options for VOICE_REALTIME_PROVIDER: "gemini_live" | "openai_realtime" | "cascaded"
VOICE_REALTIME_PROVIDER="cascaded"
# Options for PRONUNCIATION_PROVIDER: "azure_speech" | "acoustic_dsp"
PRONUNCIATION_PROVIDER="acoustic_dsp"
# Options for STT_PROVIDER: "whisper" | "deepgram" | "browser_hybrid"
STT_PROVIDER="whisper"
# Options for TTS_PROVIDER: "edge_neural" | "openai_tts" | "elevenlabs"
TTS_PROVIDER="edge_neural"

# --- External AI Provider Keys (Never exposed to Frontend) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="eastasia"
ELEVENLABS_API_KEY=""
DEEPGRAM_API_KEY=""

# --- Voice Session Cost & Rate Control ---
MAX_VOICE_SESSION_SECONDS=900
VOICE_CHUNK_MS=100
GATEKEEPER_PASS_THRESHOLD=80.0
